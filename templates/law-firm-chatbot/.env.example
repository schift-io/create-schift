# Required: get your key at https://app.schift.io/api-keys
SCHIFT_API_KEY={{API_KEY}}
SCHIFT_API_URL=https://api.schift.io

# Optional: bucket holding firm's internal knowledge base (client guides, practice FAQs)
SCHIFT_BUCKET_ID=

# Optional: assignment routing — slack webhook or email endpoint for "assign lawyer"
ASSIGN_WEBHOOK_URL=

PORT=3801
