# Required: get your key at https://app.schift.io/api-keys
SCHIFT_API_KEY={{API_KEY}}
SCHIFT_API_URL=https://api.schift.io

# Optional override. If empty, this starter creates/reuses a demo bucket.
SCHIFT_BUCKET_ID=

# Auto bucket name defaults to: <topic-slug>-<topic-hash>
# Bucket names follow the Schift dashboard rule:
# lowercase letters, numbers, and hyphens only; 3-63 chars.
SCHIFT_BUCKET_TOPIC={{PROJECT_SLUG}}-legal-rag
SCHIFT_BUCKET_NAME=

# PII endpoint options.
# Preset maps to score thresholds in this starter:
#   strong=0.35, default=0.50, full=0.20
SCHIFT_PII_PRESET=strong

PORT=3805
