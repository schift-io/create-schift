# Required: get your key at https://app.schift.io/api-keys
SCHIFT_API_KEY={{API_KEY}}
SCHIFT_API_URL=https://api.schift.io

# Required: bucket that holds the firm's internal regulation corpus
# (AML, KYC, 개인정보보호법, 금융투자업규정, etc.)
SCHIFT_BUCKET_ID=

# PII/DLP enforcement level for transaction text: default | strict | loose
REDACT_POLICY=strict

PORT=3804
