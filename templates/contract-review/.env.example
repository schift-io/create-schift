# Required: get your key at https://app.schift.io/api-keys
SCHIFT_API_KEY={{API_KEY}}
SCHIFT_API_URL=https://api.schift.io

# Optional: bucket holding firm's precedent clauses / past opinions
SCHIFT_BUCKET_ID=

# Client-side PII masking policy (default | strict | loose)
REDACT_POLICY=default

PORT=3802
