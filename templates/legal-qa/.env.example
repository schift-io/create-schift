SCHIFT_API_KEY={{API_KEY}}
SCHIFT_API_URL=https://api.schift.io

# Bucket that holds your legal corpus. Create one at https://schift.io/app,
# then seed it with: npm run seed -- --bucket-id <id>
LEGAL_BUCKET_ID=

# Optional: BYOK — direct LLM provider (OpenAI-compatible).
# If set, agent uses your provider for responses. Otherwise Schift handles it.
SCHIFT_PROVIDER_API_KEY=
SCHIFT_PROVIDER_ENDPOINT_URL=

PORT=3787
